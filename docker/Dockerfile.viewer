FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . ./
ARG VITE_BALEY_API_URL=http://127.0.0.1:8080
ARG VITE_BALEY_AUTH_MODE=enforced
ENV VITE_BALEY_API_URL=$VITE_BALEY_API_URL \
    VITE_BALEY_AUTH_MODE=$VITE_BALEY_AUTH_MODE
RUN npm run build

FROM nginx:1.27-alpine
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 5174
