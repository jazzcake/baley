FROM golang:1.26-alpine AS build
WORKDIR /src
COPY server/go.mod server/go.sum ./
RUN go mod download
COPY server/ ./
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/baley-mcp ./cmd/baley-mcp

FROM alpine:3.22
RUN apk add --no-cache ca-certificates
COPY --from=build /out/baley-mcp /app/baley-mcp
ENV BALEY_SERVER_URL=http://api:8080 \
    BALEY_MCP_HTTP_ADDR=0.0.0.0:8090
ENTRYPOINT ["/app/baley-mcp", "serve-http"]
