FROM golang:1.26-alpine AS build
ARG BALEY_BUILD_VERSION=dev
ARG BALEY_BUILD_COMMIT=unknown
ARG BALEY_BUILD_TIME=unknown
WORKDIR /src
COPY server/go.mod server/go.sum ./
RUN go mod download
COPY server/ ./
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w -X main.buildVersion=${BALEY_BUILD_VERSION} -X main.buildCommit=${BALEY_BUILD_COMMIT} -X main.buildTime=${BALEY_BUILD_TIME}" -o /out/baley-server ./cmd/baley-server

FROM alpine:3.22
ARG BALEY_BUILD_COMMIT=unknown
ARG BALEY_SCHEMA_VERSION=27
LABEL org.opencontainers.image.revision=$BALEY_BUILD_COMMIT \
      org.opencontainers.image.baley.schema-version=$BALEY_SCHEMA_VERSION
RUN apk add --no-cache ca-certificates
WORKDIR /app
COPY --from=build /out/baley-server /app/baley-server
COPY server/migrations /app/migrations
COPY docker/server-entrypoint.sh /usr/local/bin/baley-server-entrypoint
RUN sed -i 's/\r$//' /usr/local/bin/baley-server-entrypoint \
    && chmod 0755 /usr/local/bin/baley-server-entrypoint \
    && mkdir -p /var/lib/baley
ENV BALEY_ENV=development \
    BALEY_AUTH_MODE=enforced \
    BALEY_ALLOW_CONTAINER_BIND=true \
    BALEY_HTTP_ADDR=0.0.0.0:8080 \
    BALEY_MIGRATIONS_DIR=/app/migrations
ENTRYPOINT ["/usr/local/bin/baley-server-entrypoint"]
